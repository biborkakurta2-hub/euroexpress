  {
    "name": "Tipográfia",
    "settings": [
      {
        "type": "paragraph",
        "content": "A téma a Montserrat (címsorok, 800/900 vastagság, nagybetűs) és az Inter (törzsszöveg) betűtípusokat tölti be a Google Fontsról. Cseréjükhöz a layout/theme.liquid fejlécében lévő Google Fonts hivatkozást és az assets/euroexpress-tokens.css --ee-font-display / --ee-font-body változóit módosítsd."
      }
    ]
  },
  {
    "name": "Logó",
    "settings": [
      {
        "type": "paragraph",
        "content": "Töltsd fel az EuroExpress logót (SVG vagy háttér nélküli PNG). Amíg nincs feltöltve, a téma a beépített EUROEXPRESS ÁRUHÁZ logót jeleníti meg."
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logó kép"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 320,
        "step": 10,
        "unit": "px",
        "label": "Logó szélessége",
        "default": 210
      }
    ]
  },
