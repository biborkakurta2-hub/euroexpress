<div class="ee-container ee-section">
  {%- if section.settings.title != blank -%}
    <div class="ee-section__head">
      <h2 class="ee-section__title">{{ section.settings.title }}</h2>
      {%- if section.settings.link_label != blank -%}
        <a class="ee-section__link" href="{{ section.settings.link_url | default: routes.collections_url }}">
          {{ section.settings.link_label }}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="ee-tiles">
    {%- for block in section.blocks -%}
      {%- liquid
        assign ee_col = block.settings.collection
        assign ee_url = block.settings.link | default: ee_col.url | default: routes.collections_url
        assign ee_title = block.settings.title | default: ee_col.title
        assign ee_image = block.settings.image | default: ee_col.featured_image
      -%}
      <a class="ee-tile" href="{{ ee_url }}" {{ block.shopify_attributes }}>
        <span class="ee-tile__media">
          {%- if ee_image != blank -%}
            <img
              src="{{ ee_image | image_url: width: 600 }}"
              alt=""
              width="300"
              height="225"
              loading="lazy"
            >
          {%- else -%}
            {%- case block.settings.icon -%}
              {%- when 'kisgep' -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 4h9l-1.2 8.5H7.7z"/><path d="M9.3 12.5v2.6a2.7 2.7 0 002.7 2.7"/><path d="M9 20h6"/><path d="M12 17.8V20"/></svg>
              {%- when 'nagygep' -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="2.5" width="14" height="19" rx="2"/><path d="M5 9h14"/><path d="M8.5 5v2M8.5 12v3"/></svg>
              {%- when 'haztartas' -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 16h6l1-8h2l1 8h6"/><path d="M7 16v4h10v-4"/><path d="M12 8V3"/></svg>
              {%- when 'kert' -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 18h9v-4H3z"/><path d="M12 16h4l5-6v8h-9"/><circle cx="6" cy="20" r="1.6"/><circle cx="17.5" cy="20" r="1.6"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11l8-7 8 7"/><path d="M6 10v9h12v-9"/><path d="M10 19v-5h4v5"/></svg>
            {%- endcase -%}
          {%- endif -%}
        </span>
        <span class="ee-tile__body">
          {%- if block.settings.tag != blank -%}
            <span>{% render 'ee-label', text: block.settings.tag, size: 'sm' %}</span>
          {%- endif -%}
          <span class="ee-tile__title">{{ ee_title }}</span>
          {%- if block.settings.text != blank -%}
            <span class="ee-tile__text">{{ block.settings.text }}</span>
          {%- endif -%}
        </span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Kategória csempék",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Cím",
      "default": "Kategóriák"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Jobb oldali link felirata",
      "default": "Összes kategória"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Jobb oldali link"
    }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "card",
      "name": "Kategória",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Gyűjtemény"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Cím (üresen a gyűjtemény neve)"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Rövid leírás"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Piros címke",
          "default": "Nagyker ár"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Kép (üresen ikon jelenik meg)"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Ikon",
          "options": [
            { "value": "kisgep", "label": "Konyhai kisgép" },
            { "value": "nagygep", "label": "Konyhai nagygép" },
            { "value": "haztartas", "label": "Háztartás & takarítás" },
            { "value": "kert", "label": "Kerti eszközök" }
          ],
          "default": "kisgep"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Egyedi link (opcionális)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kategória csempék",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
