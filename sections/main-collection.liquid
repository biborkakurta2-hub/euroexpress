<div class="collection-banner">
  <div class="page-width">
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <p>{{ collection.description | strip_html }}</p>
    {%- endif -%}
  </div>
</div>

<div class="section-pad">
  <div class="page-width">
    {%- paginate collection.products by 12 -%}
      {%- if collection.products.size > 0 -%}
        <div class="product-grid">
          {%- for product in collection.products -%}
            {% render 'card-product', product: product %}
          {%- endfor -%}
        </div>
        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <div class="empty-state">
          <h2>Ebben a kategóriában még nincs termék</h2>
          <p>Nézz vissza később, vagy böngéssz a többi kategóriában!</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn">Összes termék</a>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Gyűjtemény oldal",
  "settings": []
}
{% endschema %}
