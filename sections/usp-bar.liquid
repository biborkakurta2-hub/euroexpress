<div class="usp-bar">
  <div class="page-width usp-bar__inner">
    {%- for block in section.blocks -%}
      <div class="usp" {{ block.shopify_attributes }}>
        <div class="usp__icon">
          {%- case block.settings.icon -%}
            {%- when 'truck' -%}
              <svg viewBox="0 0 24 24"><path d="M3 6h11v10H3z"/><path d="M14 9h4l3 3.5V16h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="17.5" cy="18" r="2"/></svg>
            {%- when 'chat' -%}
              <svg viewBox="0 0 24 24"><path d="M4 5h16v11H9l-4 3z"/><path d="M8 9.5h8M8 12.5h5"/></svg>
            {%- when 'shield' -%}
              <svg viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
            {%- else -%}
              <svg viewBox="0 0 24 24"><path d="M11 3H4v7l9 9 7-7-9-9z"/><circle cx="7.5" cy="7.5" r="1.4"/></svg>
          {%- endcase -%}
        </div>
        <div>
          <h3 class="usp__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}
            <div class="usp__text">{{ block.settings.text }}</div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Előnyök sáv",
  "blocks": [
    {
      "type": "usp",
      "name": "Előny",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ikon",
          "default": "tag",
          "options": [
            { "value": "tag", "label": "Árcédula" },
            { "value": "truck", "label": "Szállítás" },
            { "value": "chat", "label": "Üzenet" },
            { "value": "shield", "label": "Pajzs" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Cím",
          "default": "Nagyker árak"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Szöveg"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Előnyök sáv",
      "blocks": [
        {
          "type": "usp",
          "settings": {
            "icon": "tag",
            "title": "Nagyker árak",
            "text": "Közvetlen beszerzés, felesleges árrés nélkül. Ugyanaz a minőség, jobb áron."
          }
        },
        {
          "type": "usp",
          "settings": {
            "icon": "truck",
            "title": "Gyors szállítás",
            "text": "Rendeld meg online, mi pedig kiszállítjuk gyorsan és megbízhatóan."
          }
        },
        {
          "type": "usp",
          "settings": {
            "icon": "chat",
            "title": "Rendelés üzenetben",
            "text": "Nincs bonyodalom — írj ránk üzenetben, és mi intézzük a rendelésed."
          }
        }
      ]
    }
  ]
}
{% endschema %}
