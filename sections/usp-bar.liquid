<div class="ee-usps">
  <div class="ee-container">
    <div class="ee-usps__inner">
      {%- for block in section.blocks -%}
        <div class="ee-usp" {{ block.shopify_attributes }}>
          <span class="ee-usp__icon">
            {%- case block.settings.icon -%}
              {%- when 'tag' -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12.5V4h8.5L21 13.5 13.5 21z"/><circle cx="7.5" cy="7.5" r="1.4"/></svg>
              {%- when 'truck' -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8h12v8a1 1 0 01-1 1H4a1 1 0 01-1-1z"/><path d="M15 11h3l3 3v3h-6z"/><circle cx="7.5" cy="18.5" r="1.8"/><circle cx="17.5" cy="18.5" r="1.8"/></svg>
              {%- when 'cash' -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="6" width="19" height="12" rx="2"/><circle cx="12" cy="12" r="2.6"/></svg>
              {%- when 'chat' -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a8 8 0 01-11.6 7.1L4 20.5l1.4-5A8 8 0 1121 12z"/></svg>
              {%- when 'shield' -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7.5 3v5.5c0 4.4-3.1 8.3-7.5 9.5-4.4-1.2-7.5-5.1-7.5-9.5V6z"/><path d="M9 12l2 2 4-4"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9 12l2 2 4-4"/></svg>
            {%- endcase -%}
          </span>
          <span>
            <span class="ee-usp__title">{{ block.settings.title }}</span>
            {%- if block.settings.text != blank -%}
              <span class="ee-usp__text">{{ block.settings.text }}</span>
            {%- endif -%}
          </span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Előnyök sáv",
  "tag": "section",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "usp",
      "name": "Előny",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ikon",
          "options": [
            { "value": "tag", "label": "Árcédula" },
            { "value": "truck", "label": "Szállítás" },
            { "value": "cash", "label": "Utánvét / fizetés" },
            { "value": "chat", "label": "Üzenet" },
            { "value": "shield", "label": "Garancia" }
          ],
          "default": "tag"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Cím",
          "default": "Nagyker árak"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Szöveg",
          "default": "Közvetlen beszerzés, felesleges árrés nélkül."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Előnyök sáv",
      "blocks": [
        { "type": "usp" },
        { "type": "usp" },
        { "type": "usp" },
        { "type": "usp" }
      ]
    }
  ]
}
{% endschema %}
