<div class="password-page">
  {% render 'logo', size: 'large' %}

  <h1>Hamarosan nyitunk!</h1>

  {%- if shop.password_message != blank -%}
    <p>{{ shop.password_message }}</p>
  {%- else -%}
    <p>Háztartási gépek, konyhai eszközök és kerti felszerelés — nagyker árakon, egy webshopban.</p>
  {%- endif -%}

  {% form 'storefront_password' %}
    {%- if form.errors -%}
      <p role="alert" style="background: #111; padding: 8px 14px; border-radius: 5px;">Hibás jelszó — próbáld újra!</p>
    {%- endif -%}
    <label for="Password" class="visually-hidden">Jelszó</label>
    <input id="Password" type="password" name="password" placeholder="Jelszó" required>
    <button type="submit" class="btn">Belépés</button>
  {% endform %}
</div>

{% schema %}
{
  "name": "Jelszavas oldal",
  "settings": []
}
{% endschema %}
