{%- comment -%} SEO vásárlási útmutató blokk a kollekció lista alján — összecsukható szekciókkal {%- endcomment -%}
<div class="page-width section-{{ section.id }}-padding">
  <div class="ee-buying-guide">
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <div class="rte">{{ section.settings.intro }}</div>
    {%- endif -%}
    {%- if section.settings.use_collection_description and collection.description != blank -%}
      <div class="rte">{{ collection.description }}</div>
    {%- endif -%}
    {%- for block in section.blocks -%}
      <details {{ block.shopify_attributes }}{% if forloop.first %} open{% endif %}>
        <summary>{{ block.settings.question }}</summary>
        <div class="rte" style="padding-top:8px">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</div>

{% style %}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
{% endstyle %}

{% schema %}
{
  "name": "Vásárlási útmutató",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Cím", "default": "Vásárlási útmutató" },
    { "type": "richtext", "id": "intro", "label": "Bevezető", "default": "<p>Segítünk kiválasztani a számodra ideális háztartási gépet. Az alábbiakban a leggyakoribb kérdéseket és szempontokat gyűjtöttük össze.</p>" },
    { "type": "checkbox", "id": "use_collection_description", "label": "Gyűjtemény leírásának megjelenítése", "default": true },
    { "type": "range", "id": "padding_top", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Felső térköz", "default": 8 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Alsó térköz", "default": 40 }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Kérdés / szempont",
      "settings": [
        { "type": "text", "id": "question", "label": "Kérdés", "default": "Mire figyeljek vásárláskor?" },
        { "type": "richtext", "id": "answer", "label": "Válasz", "default": "<p>Nézd meg a teljesítményt (W), a kapacitást és az energiaosztályt. Kérdés esetén írj nekünk üzenetben!</p>" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{
    "name": "Vásárlási útmutató",
    "blocks": [
      { "type": "faq", "settings": { "question": "Milyen teljesítményt válasszak?", "answer": "<p>Kisgépeknél a nagyobb wattszám gyorsabb, erősebb működést jelent. Napi használatra a 800–1200 W tartomány ideális a legtöbb konyhai kisgéphez.</p>" } },
      { "type": "faq", "settings": { "question": "Mennyi a szállítási idő?", "answer": "<p>Raktáron lévő termékeket jellemzően 1–3 munkanapon belül kiszállítjuk országosan, futárral vagy Foxpost csomagpontra.</p>" } },
      { "type": "faq", "settings": { "question": "Lehet utánvéttel fizetni?", "answer": "<p>Igen, az utánvétes fizetés elérhető. Bankkártyás fizetés is választható a pénztárnál.</p>" } }
    ]
  }]
}
{% endschema %}
