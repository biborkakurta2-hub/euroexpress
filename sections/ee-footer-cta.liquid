{%- comment -%} EuroExpress alsó piros CTA sáv — VÁSÁROLJ MOST + kapcsolat ikonok {%- endcomment -%}
<div class="page-width" style="padding-top:24px">
  <div class="ee-footer-cta">
    <p class="ee-footer-cta__title">{{ section.settings.title }}</p>
    <div class="ee-footer-cta__actions">
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="ee-btn">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.facebook != blank -%}
        <a class="ee-footer-cta__icon" href="{{ section.settings.facebook }}" aria-label="Facebook üzenet" target="_blank" rel="noopener">
          <span class="icon"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5h1.65V3.6C16.6 3.5 15.6 3.4 14.5 3.4c-2.35 0-3.95 1.43-3.95 4.06v2.44H7.8V13h2.75v8z"/></svg></span>
        </a>
      {%- endif -%}
      {%- if section.settings.email != blank -%}
        <a class="ee-footer-cta__icon" href="mailto:{{ section.settings.email }}" aria-label="E-mail">
          <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></span>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Footer CTA sáv",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Cím", "default": "Nem találod, amit keresel? Írj nekünk!" },
    { "type": "text", "id": "button_label", "label": "Gomb felirata", "default": "VÁSÁROLJ MOST" },
    { "type": "url", "id": "button_link", "label": "Gomb link" },
    { "type": "url", "id": "facebook", "label": "Facebook link (üzenetben)" },
    { "type": "text", "id": "email", "label": "E-mail cím", "default": "info@euroexpress.hu" }
  ],
  "presets": [{ "name": "Footer CTA sáv" }]
}
{% endschema %}
