<div class="newsletter section-pad">
  <div class="page-width">
    <h2>{{ section.settings.title }}</h2>
    {%- if section.settings.text != blank -%}
      <p>{{ section.settings.text }}</p>
    {%- endif -%}

    {% form 'customer', class: 'newsletter__form-wrapper' %}
      {%- if form.posted_successfully? -%}
        <div class="newsletter__success">Sikeresen feliratkoztál a hírlevelünkre!</div>
      {%- else -%}
        {%- if form.errors -%}
          <div class="newsletter__success" role="alert">Hiba történt — kérjük, ellenőrizd az e-mail címet.</div>
        {%- endif -%}
        <div class="newsletter__form">
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label for="NewsletterEmail-{{ section.id }}" class="visually-hidden">E-mail cím</label>
          <input
            id="NewsletterEmail-{{ section.id }}"
            type="email"
            name="contact[email]"
            placeholder="E-mail címed"
            required
            autocomplete="email"
          >
          <button type="submit" class="btn btn--red">Feliratkozás</button>
        </div>
      {%- endif -%}
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "Hírlevél",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Cím",
      "default": "Ne maradj le az akciókról!"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Szöveg",
      "default": "Iratkozz fel, és elsőként értesülhetsz a nagyker árú újdonságokról és katalógus-ajánlatokról."
    }
  ],
  "presets": [
    {
      "name": "Hírlevél"
    }
  ]
}
{% endschema %}
