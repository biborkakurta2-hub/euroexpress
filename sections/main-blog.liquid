<div class="section-pad">
  <div class="page-width">
    <div class="page-title">
      <h1>{{ blog.title }}</h1>
    </div>

    {%- paginate blog.articles by 9 -%}
      {%- if blog.articles.size > 0 -%}
        <div class="blog-grid">
          {%- for article in blog.articles -%}
            <a href="{{ article.url }}" class="article-card">
              {%- if article.image -%}
                <div class="article-card__image">
                  <img
                    src="{{ article.image | image_url: width: 700 }}"
                    alt="{{ article.image.alt | default: article.title | escape }}"
                    loading="lazy"
                  >
                </div>
              {%- endif -%}
              <div class="article-card__body">
                <div class="article-card__date">{{ article.published_at | date: '%Y. %m. %d.' }}</div>
                <h2 class="article-card__title">{{ article.title }}</h2>
                {%- if article.excerpt_or_content != blank -%}
                  <div class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</div>
                {%- endif -%}
              </div>
            </a>
          {%- endfor -%}
        </div>
        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <div class="empty-state">
          <h2>Még nincs bejegyzés</h2>
          <p>Hamarosan érkeznek híreink és akcióink!</p>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Blog oldal",
  "settings": []
}
{% endschema %}
