{%- comment -%} EuroExpress kategória csempék — 4 nagy kártya képpel + piros címkével {%- endcomment -%}
<div class="page-width section-{{ section.id }}-padding">
  {%- if section.settings.heading != blank -%}
    <h2 class="ee-section-title">{{ section.settings.heading }}</h2>
  {%- endif -%}
  <div class="ee-cat-tiles">
    {%- for block in section.blocks -%}
      <a class="ee-cat-tile" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', widths: '300, 450, 600' }}
        {%- endif -%}
        {%- if block.settings.label != blank -%}
          {% render 'ee-label', text: block.settings.label %}
        {%- endif -%}
        <span class="ee-cat-tile__name">{{ block.settings.title }}</span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% style %}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
{% endstyle %}

{% schema %}
{
  "name": "Kategória csempék",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Cím", "default": "Kategóriák" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Felső térköz", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Alsó térköz", "default": 12 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Csempe",
      "settings": [
        { "type": "text", "id": "title", "label": "Kategória neve", "default": "Kategória" },
        { "type": "text", "id": "label", "label": "Piros címke", "default": "Új" },
        { "type": "image_picker", "id": "image", "label": "Háttérkép" },
        { "type": "url", "id": "link", "label": "Link a gyűjteményre" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{
    "name": "Kategória csempék",
    "blocks": [
      { "type": "tile", "settings": { "title": "Konyhai kisgépek", "label": "Kisgépek" } },
      { "type": "tile", "settings": { "title": "Konyhai nagygépek", "label": "Nagygépek" } },
      { "type": "tile", "settings": { "title": "Háztartás & takarítás", "label": "Otthon" } },
      { "type": "tile", "settings": { "title": "Kerti eszközök", "label": "Kert" } }
    ]
  }]
}
{% endschema %}
