{%- comment -%} Alkategória-csempék sora — vízszintesen görgethető, kerek képekkel (Otto stílus) {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <div class="page-width" style="padding-top:8px">
    {%- if section.settings.heading != blank -%}
      <h2 class="ee-section-title" style="font-size:1.15rem">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="ee-subcats">
      {%- for block in section.blocks -%}
        <a class="ee-subcat" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
          <span class="ee-subcat__img">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '96, 192' }}
            {%- endif -%}
          </span>
          <span>{{ block.settings.title }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Alkategória csempék",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Cím", "default": "Böngéssz alkategóriában" }
  ],
  "blocks": [
    {
      "type": "subcat",
      "name": "Alkategória",
      "settings": [
        { "type": "text", "id": "title", "label": "Név", "default": "Alkategória" },
        { "type": "image_picker", "id": "image", "label": "Kép" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{
    "name": "Alkategória csempék",
    "blocks": [
      { "type": "subcat", "settings": { "title": "Vízforraló" } },
      { "type": "subcat", "settings": { "title": "Mixer" } },
      { "type": "subcat", "settings": { "title": "Kávéfőző" } },
      { "type": "subcat", "settings": { "title": "Kenyérpirító" } },
      { "type": "subcat", "settings": { "title": "Turmixgép" } },
      { "type": "subcat", "settings": { "title": "Aprító" } }
    ]
  }]
}
{% endschema %}
