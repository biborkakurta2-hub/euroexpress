<div class="section-pad">
  <div class="page-width">
    <div class="page-title">
      <h1>Kategóriák</h1>
    </div>

    <div class="card-grid">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" class="info-card">
          <div class="info-card__thumb">
            {%- if collection.featured_image -%}
              <img
                src="{{ collection.featured_image | image_url: width: 700 }}"
                alt="{{ collection.featured_image.alt | default: collection.title | escape }}"
                loading="lazy"
              >
            {%- else -%}
              <svg viewBox="0 0 24 24"><path d="M11 3H4v7l9 9 7-7-9-9z"/><circle cx="7.5" cy="7.5" r="1.4"/></svg>
            {%- endif -%}
          </div>
          <span class="info-card__label label-red">{{ collection.title }}</span>
          {%- if collection.products_count > 0 -%}
            <span class="info-card__tag tag-dark">{{ collection.products_count }} termék</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Kategória lista",
  "settings": []
}
{% endschema %}
