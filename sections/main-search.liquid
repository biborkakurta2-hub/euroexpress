{% render 'ee-breadcrumbs' %}

<div class="ee-container ee-section--tight">
  <div class="ee-collection__header">
    <h1 class="ee-collection__title">
      {%- if search.performed -%}
        Találatok: „{{ search.terms | escape }}”
      {%- else -%}
        Keresés
      {%- endif -%}
    </h1>
  </div>

  <form action="{{ routes.search_url }}" method="get" role="search" class="ee-search" style="max-width: 560px; margin-bottom: 20px;">
    <label for="SearchInput" class="visually-hidden">Keresés</label>
    <input type="hidden" name="type" value="product">
    <input
      id="SearchInput"
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="Mit keresel?"
    >
    <button type="submit" class="ee-search__submit" aria-label="Keresés">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.5-4.5"/></svg>
    </button>
  </form>

  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      {%- if search.results.size > 0 -%}
        <div class="ee-toolbar">
          <div class="ee-toolbar__count">{{ search.results_count | default: search.results.size }} találat</div>
          {%- if search.sort_options.size > 0 -%}
            <div class="ee-toolbar__right">
              <form method="get" action="{{ routes.search_url }}">
                <input type="hidden" name="q" value="{{ search.terms | escape }}">
                <input type="hidden" name="type" value="product">
                <label class="visually-hidden" for="EeSearchSort">Rendezés</label>
                <select id="EeSearchSort" name="sort_by" data-ee-sort>
                  {%- for option in search.sort_options -%}
                    <option value="{{ option.value }}" {% if option.value == search.sort_by %}selected{% endif %}>
                      {{ option.name }}
                    </option>
                  {%- endfor -%}
                </select>
              </form>
            </div>
          {%- endif -%}
        </div>

        <div class="ee-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'card-product', product: item %}
            {%- else -%}
              <a href="{{ item.url }}" class="ee-card" style="padding: 18px;">
                <span class="ee-card__title" style="min-height: 0; font-weight: 700;">{{ item.title }}</span>
                {%- if item.content != blank -%}
                  <span class="ee-tile__text">{{ item.content | strip_html | truncate: 120 }}</span>
                {%- endif -%}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {% render 'ee-pagination', paginate: paginate %}
      {%- else -%}
        <div class="ee-empty">
          <h2>Nincs találat</h2>
          <p>A(z) „{{ search.terms | escape }}” kifejezésre nem találtunk terméket. Próbáld más szavakkal!</p>
          <a href="{{ routes.all_products_collection_url }}" class="ee-btn ee-btn--red">Összes termék</a>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Kereső oldal",
  "tag": "section",
  "settings": []
}
{% endschema %}
