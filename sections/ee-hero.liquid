{%- comment -%} EuroExpress hero — piros display blokk + termékmontázs + starburst + CTA {%- endcomment -%}
<div class="ee-hero page-width section-{{ section.id }}-padding">
  <div class="ee-hero__inner">
    <div class="ee-hero__copy">
      {%- if section.settings.show_starburst -%}
        <span class="ee-hero__starburst">
          {% render 'ee-starburst', text: section.settings.starburst_text %}
        </span>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="ee-hero__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="ee-hero__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_link | default: '#' }}" class="ee-btn ee-hero__cta">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
    </div>
    <div class="ee-hero__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'eager', sizes: '(min-width: 750px) 50vw, 100vw', widths: '600, 900, 1200' }}
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  </div>
</div>

{% style %}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
{% endstyle %}

{% schema %}
{
  "name": "EuroExpress hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Cím", "default": "HÁZTARTÁSI GÉPEK — NAGYKER ÁRON" },
    { "type": "textarea", "id": "subtitle", "label": "Alcím", "default": "Konyhai kisgépek, nagygépek, takarítás és kert — közvetlen nagykereskedelmi árakon, gyors kiszállítással." },
    { "type": "text", "id": "cta_label", "label": "Gomb felirata", "default": "VÁSÁROLJ MOST" },
    { "type": "url", "id": "cta_link", "label": "Gomb link (pl. Akciók gyűjtemény)" },
    { "type": "image_picker", "id": "image", "label": "Hero kép (termékmontázs)" },
    { "type": "checkbox", "id": "show_starburst", "label": "Csillag badge megjelenítése", "default": true },
    { "type": "text", "id": "starburst_text", "label": "Csillag badge szövege", "default": "Nagyker árak" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Felső térköz", "default": 28 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Alsó térköz", "default": 28 }
  ],
  "presets": [{ "name": "EuroExpress hero" }]
}
{% endschema %}
