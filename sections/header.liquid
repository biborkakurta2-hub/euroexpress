{%- liquid
  assign ee_menu = section.settings.menu
  assign ee_cart_count = cart.item_count
-%}

<header class="ee-header" data-ee-header>
  <div class="ee-header__main">
    <div class="ee-container ee-header__row">

      <button
        type="button"
        class="ee-header__burger"
        aria-label="Menü megnyitása"
        aria-expanded="false"
        aria-controls="EeMobileMenu"
        data-ee-menu-toggle
      >
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>

      <a href="{{ routes.root_url }}" class="ee-header__logo" aria-label="{{ shop.name | escape }} — Főoldal">
        {% render 'logo' %}
      </a>

      <form action="{{ routes.search_url }}" method="get" role="search" class="ee-search">
        <label class="visually-hidden" for="EeHeaderSearch">Keresés a termékek között</label>
        <input type="hidden" name="type" value="product">
        <input
          id="EeHeaderSearch"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="Keresés a termékek között…"
          autocomplete="off"
        >
        <button type="submit" class="ee-search__submit" aria-label="Keresés">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.5-4.5"/></svg>
        </button>
      </form>

      <div class="ee-header__actions">
        {%- if shop.customer_accounts_enabled -%}
          <a
            href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
            class="ee-header__action"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"/></svg>
            <span class="ee-header__action-text">{% if customer %}Fiókom{% else %}Belépés{% endif %}</span>
          </a>
        {%- endif -%}

        <a href="{{ routes.cart_url }}" class="ee-header__action" aria-label="Kosár ({{ ee_cart_count }} termék)">
          <span class="ee-header__cart-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 7h12l1.5 12.5a1 1 0 01-1 1.1H5.5a1 1 0 01-1-1.1z"/><path d="M9 10V6a3 3 0 016 0v4"/></svg>
            {%- if ee_cart_count > 0 -%}
              <span class="ee-header__cart-count" aria-hidden="true">{{ ee_cart_count }}</span>
            {%- endif -%}
          </span>
          <span class="ee-header__action-text">Kosár</span>
        </a>
      </div>

    </div>
  </div>

  {%- if ee_menu != blank and ee_menu.links.size > 0 -%}
    <nav class="ee-nav" aria-label="Fő kategóriák">
      <div class="ee-container">
        <ul class="ee-nav__list">
          {%- for link in ee_menu.links -%}
            <li class="ee-nav__item{% if link.links.size > 0 %} ee-nav__item--mega{% endif %}">
              <a
                class="ee-nav__link{% if link.current or link.child_current %} is-current{% endif %}"
                href="{{ link.url }}"
                {% if link.links.size > 0 %}aria-haspopup="true"{% endif %}
              >
                {{ link.title }}
                {%- if link.links.size > 0 -%}
                  <svg class="ee-nav__caret" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                {%- endif -%}
              </a>

              {%- if link.links.size > 0 -%}
                <div class="ee-mega">
                  <div class="ee-container ee-mega__inner">
                    {%- for child in link.links -%}
                      <div class="ee-mega__col">
                        <a class="ee-mega__title" href="{{ child.url }}">{{ child.title }}</a>
                        {%- if child.links.size > 0 -%}
                          <ul class="ee-mega__sub">
                            {%- for grandchild in child.links -%}
                              <li><a href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </div>
                    {%- endfor -%}

                    {%- if section.settings.mega_promo_text != blank -%}
                      <div class="ee-mega__promo">
                        <p>{{ section.settings.mega_promo_text }}</p>
                        {%- if section.settings.mega_promo_link != blank -%}
                          <a class="ee-btn ee-btn--dark ee-btn--sm" href="{{ section.settings.mega_promo_link }}">
                            {{ section.settings.mega_promo_label | default: 'Akciók' }}
                          </a>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </nav>
  {%- endif -%}

  {%- comment -%} Mobil menü {%- endcomment -%}
  <div class="ee-mobile-menu" id="EeMobileMenu" hidden data-ee-mobile-menu>
    <div class="ee-mobile-menu__inner">
      {%- for link in ee_menu.links -%}
        {%- if link.links.size > 0 -%}
          <details class="ee-mobile-menu__group">
            <summary>
              {{ link.title }}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <a class="ee-mobile-menu__all" href="{{ link.url }}">Összes: {{ link.title }}</a>
            {%- for child in link.links -%}
              <a class="ee-mobile-menu__child" href="{{ child.url }}">{{ child.title }}</a>
            {%- endfor -%}
          </details>
        {%- else -%}
          <a class="ee-mobile-menu__link" href="{{ link.url }}">{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}

      {%- if settings.contact_email != blank -%}
        <a class="ee-mobile-menu__link ee-mobile-menu__link--muted" href="mailto:{{ settings.contact_email }}">
          {{ settings.contact_email }}
        </a>
      {%- endif -%}
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Fejléc",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Kategória menü",
      "info": "A mega-menühöz készíts a Navigáció menüben al- és al-al-menüpontokat.",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Mega-menü kiemelés"
    },
    {
      "type": "text",
      "id": "mega_promo_text",
      "label": "Kiemelt szöveg",
      "default": "Nagyker árak — minden héten új akciók!"
    },
    {
      "type": "text",
      "id": "mega_promo_label",
      "label": "Gomb felirata",
      "default": "Akciók"
    },
    {
      "type": "url",
      "id": "mega_promo_link",
      "label": "Gomb linkje"
    }
  ]
}
{% endschema %}
