<footer class="ee-footer">
  <div class="ee-footer__cta">
    <div class="ee-container ee-footer__cta-inner">
      {%- if section.settings.button_label != blank -%}
        <a
          href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
          class="ee-btn ee-btn--dark ee-btn--lg"
        >
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}

      {%- if settings.social_facebook != blank -%}
        <a href="{{ settings.social_facebook }}" class="ee-footer__contact" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="#fff"><path d="M22 12a10 10 0 10-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.2c-1.2 0-1.6.8-1.6 1.5V12h2.7l-.4 2.9h-2.3v7A10 10 0 0022 12z"/></svg>
          üzenetben vagy
        </a>
      {%- endif -%}

      {%- if settings.contact_email != blank -%}
        <a href="mailto:{{ settings.contact_email }}" class="ee-footer__contact">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="#fff" stroke-width="2"><rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="M3 7l9 6.5L21 7"/></svg>
          {{ settings.contact_email }}
        </a>
      {%- endif -%}

      {%- if settings.contact_phone != blank -%}
        <a href="tel:{{ settings.contact_phone | remove: ' ' }}" class="ee-footer__contact">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.1 1 .4 2 .7 2.9a2 2 0 01-.4 2.1L8.1 10a16 16 0 006 6l1.3-1.3a2 2 0 012.1-.4c.9.3 1.9.6 2.9.7a2 2 0 011.6 2z"/></svg>
          {{ settings.contact_phone }}
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="ee-footer__main">
    <div class="ee-container">
      <div class="ee-footer__cols">
        <div class="ee-footer__col">
          <a class="ee-footer__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} — Főoldal">
            {% render 'logo' %}
          </a>
          {%- if section.settings.about_text != blank -%}
            <p class="ee-footer__about">{{ section.settings.about_text }}</p>
          {%- endif -%}
        </div>

        {%- for block in section.blocks -%}
          <div class="ee-footer__col" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.title }}</h3>
            {%- if block.settings.menu != blank -%}
              <ul>
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <div class="ee-payments" aria-label="Elfogadott fizetési módok">
        {%- assign ee_payments = section.settings.payment_methods | default: 'SimplePay,Barion,Bankkártya,Utánvét,Foxpost,Átutalás' | split: ',' -%}
        {%- for method in ee_payments -%}
          <span class="ee-payment">{{ method | strip }}</span>
        {%- endfor -%}
      </div>
    </div>
  </div>

  <div class="ee-footer__legal">
    <div class="ee-container ee-footer__legal-inner">
      <div>
        {%- if section.settings.legal_menu != blank -%}
          {%- for link in section.settings.legal_menu.links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        {%- endif -%}
      </div>
      <div>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} — Minden jog fenntartva.</div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Lábléc",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "CTA gomb felirata",
      "default": "Vásárolj most"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "CTA gomb linkje"
    },
    {
      "type": "textarea",
      "id": "about_text",
      "label": "Rövid bemutatkozás",
      "default": "Háztartási gépek, konyhai kisgépek és kerti eszközök nagyker áron — közvetlen beszerzésből, felesleges árrés nélkül."
    },
    {
      "type": "text",
      "id": "payment_methods",
      "label": "Fizetési módok (vesszővel elválasztva)",
      "default": "SimplePay,Barion,Bankkártya,Utánvét,Foxpost,Átutalás"
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Jogi menü (ÁSZF, Adatvédelem, Cookie)",
      "info": "Hozz létre egy menüt a Navigáció alatt az ÁSZF, Adatvédelmi és Cookie-tájékoztató oldalakkal."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link oszlop",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Oszlop címe",
          "default": "Kategóriák"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menü"
        }
      ]
    }
  ]
}
{% endschema %}
