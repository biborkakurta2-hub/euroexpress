<footer>
  <div class="footer__cta">
    <div class="page-width footer__cta-inner">
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}

      {%- if settings.social_facebook != blank -%}
        <a href="{{ settings.social_facebook }}" class="footer__contact" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 12a10 10 0 10-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.2c-1.2 0-1.6.8-1.6 1.5V12h2.7l-.4 2.9h-2.3v7A10 10 0 0022 12z"/></svg>
          üzenetben vagy
        </a>
      {%- endif -%}

      {%- if settings.contact_email != blank -%}
        <a href="mailto:{{ settings.contact_email }}" class="footer__contact">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18v14H3z" fill="none" stroke="#fff" stroke-width="2"/><path d="M3 6l9 7 9-7" fill="none" stroke="#fff" stroke-width="2"/></svg>
          {{ settings.contact_email }}
        </a>
      {%- endif -%}

      {%- if settings.contact_phone != blank -%}
        <a href="tel:{{ settings.contact_phone | remove: ' ' }}" class="footer__contact">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.1 1 .4 2 .7 2.9a2 2 0 01-.4 2.1L8.1 10a16 16 0 006 6l1.3-1.3a2 2 0 012.1-.4c.9.3 1.9.6 2.9.7a2 2 0 011.6 2z"/></svg>
          {{ settings.contact_phone }}
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="footer__bottom">
    <div class="page-width footer__bottom-inner">
      {%- if section.settings.menu != blank -%}
        <ul class="footer__menu">
          {%- for link in section.settings.menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      <div>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} — Minden jog fenntartva.</div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Lábléc",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Gomb felirata",
      "default": "Vásárolj most"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Gomb linkje"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Lábléc menü",
      "default": "footer"
    }
  ]
}
{% endschema %}
