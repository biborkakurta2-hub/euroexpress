{%- comment -%} EuroExpress előnyök (USP) sáv — ikonos pontok {%- endcomment -%}
{%- liquid
  assign truck = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7h13v10H3z"/><path d="M16 10h4l1 3v4h-5z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>'
  assign shield = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/></svg>'
  assign card = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18"/></svg>'
  assign chat = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 5h16v11H8l-4 3z"/></svg>'
  assign tag = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12l9-9 9 9-9 9z"/><circle cx="8.5" cy="8.5" r="1.4"/></svg>'
-%}
<div class="page-width section-{{ section.id }}-padding">
  <div class="ee-usp">
    {%- for block in section.blocks -%}
      <div class="ee-usp__item" {{ block.shopify_attributes }}>
        <span class="ee-usp__icon">
          {%- case block.settings.icon -%}
            {%- when 'truck' -%}{{ truck }}
            {%- when 'shield' -%}{{ shield }}
            {%- when 'card' -%}{{ card }}
            {%- when 'chat' -%}{{ chat }}
            {%- else -%}{{ tag }}
          {%- endcase -%}
        </span>
        <span class="ee-usp__text">
          <strong>{{ block.settings.title }}</strong>
          {%- if block.settings.subtitle != blank -%}<span>{{ block.settings.subtitle }}</span>{%- endif -%}
        </span>
      </div>
    {%- endfor -%}
  </div>
</div>

{% style %}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
{% endstyle %}

{% schema %}
{
  "name": "Előnyök sáv",
  "tag": "section",
  "settings": [
    { "type": "range", "id": "padding_top", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Felső térköz", "default": 12 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Alsó térköz", "default": 12 }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "Előny",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Ikon", "default": "tag",
          "options": [
            { "value": "tag", "label": "Címke (nagyker ár)" },
            { "value": "truck", "label": "Szállítás" },
            { "value": "shield", "label": "Garancia" },
            { "value": "card", "label": "Fizetés / utánvét" },
            { "value": "chat", "label": "Üzenet / kapcsolat" }
          ]
        },
        { "type": "text", "id": "title", "label": "Cím", "default": "Előny" },
        { "type": "text", "id": "subtitle", "label": "Alcím" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{
    "name": "Előnyök sáv",
    "blocks": [
      { "type": "usp", "settings": { "icon": "tag", "title": "Nagykereskedelmi árak", "subtitle": "Közvetlen beszerzés" } },
      { "type": "usp", "settings": { "icon": "truck", "title": "Gyors kiszállítás", "subtitle": "Országosan, akár 1–3 nap" } },
      { "type": "usp", "settings": { "icon": "card", "title": "Utánvét lehetséges", "subtitle": "Fizetés átvételkor" } },
      { "type": "usp", "settings": { "icon": "chat", "title": "Kapcsolat üzenetben", "subtitle": "Gyors válasz" } }
    ]
  }]
}
{% endschema %}
