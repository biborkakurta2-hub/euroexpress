<div class="ee-hero">
  <div class="ee-hero__text">
    <h1 class="ee-hero__title">{{ section.settings.title }}</h1>

    {%- if section.settings.subtitle != blank -%}
      <div class="ee-hero__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}

    <div class="ee-hero__actions">
      {%- if section.settings.button_label != blank -%}
        <a
          href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
          class="ee-btn ee-btn--dark ee-btn--lg"
        >
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}

      {%- if section.settings.button2_label != blank -%}
        <a href="{{ section.settings.button2_link }}" class="ee-btn ee-btn--red ee-btn--lg" style="box-shadow: inset 0 0 0 2px #fff;">
          {{ section.settings.button2_label }}
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="ee-hero__media">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 1400 }}"
        srcset="{{ section.settings.image | image_url: width: 700 }} 700w, {{ section.settings.image | image_url: width: 1400 }} 1400w"
        sizes="(min-width: 900px) 50vw, 100vw"
        alt="{{ section.settings.image.alt | escape }}"
        width="1400"
        height="900"
        loading="eager"
      >
    {%- else -%}
      <div class="ee-hero__collage" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M6.5 4h9l-1.2 8.5H7.7z"/><path d="M9.3 12.5v2.6a2.7 2.7 0 002.7 2.7"/><path d="M9 20h6"/><path d="M12 17.8V20"/></svg>
        <svg viewBox="0 0 24 24"><path d="M8 3h8v6a4 4 0 01-8 0z"/><path d="M12 15v5"/><path d="M8.5 20h7"/></svg>
        <svg viewBox="0 0 24 24"><path d="M6 20l3-10h6l3 10z"/><path d="M9 10V6a3 3 0 016 0v4"/></svg>
        <svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="14" rx="2"/><path d="M4 10h16"/><path d="M8.5 5V2.8M15.5 5V2.8"/></svg>
        <svg viewBox="0 0 24 24"><path d="M7 21V9a5 5 0 0110 0v12"/><path d="M5.5 21h13"/><path d="M12 4V2"/></svg>
        <svg viewBox="0 0 24 24"><path d="M3 8h12v8a1 1 0 01-1 1H4a1 1 0 01-1-1z"/><path d="M15 11h3l3 3v3h-6z"/><circle cx="7.5" cy="18.5" r="1.8"/><circle cx="17.5" cy="18.5" r="1.8"/></svg>
        <svg viewBox="0 0 24 24"><path d="M6 3h6l1 5-2 12a2 2 0 01-4 0L5 8z"/><path d="M5.4 8h7.6"/></svg>
        <svg viewBox="0 0 24 24"><path d="M4 11l8-7 8 7"/><path d="M6 10v9h12v-9"/><path d="M10 19v-5h4v5"/></svg>
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.show_burst -%}
    <div class="ee-hero__burst">
      {% render 'ee-starburst',
        text: section.settings.burst_text,
        theme: section.settings.burst_theme,
        size: section.settings.burst_size
      %}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Hero (piros fejléc)",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Főcím",
      "default": "Háztartási gépek — nagyker áron"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Alcím",
      "default": "<p>Konyhai kisgépek, nagygépek, takarítás és kerti eszközök — egy helyen, közvetlen beszerzésből.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Gomb felirata",
      "default": "Vásárolj most"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Gomb linkje"
    },
    {
      "type": "text",
      "id": "button2_label",
      "label": "Második gomb felirata"
    },
    {
      "type": "url",
      "id": "button2_link",
      "label": "Második gomb linkje"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Termékmontázs kép (jobb oldal)"
    },
    {
      "type": "header",
      "content": "Csillag jelvény"
    },
    {
      "type": "checkbox",
      "id": "show_burst",
      "label": "Megjelenítés",
      "default": true
    },
    {
      "type": "textarea",
      "id": "burst_text",
      "label": "Felirat",
      "default": "Nagyker\nárak"
    },
    {
      "type": "select",
      "id": "burst_theme",
      "label": "Stílus",
      "options": [
        { "value": "white", "label": "Fehér csillag, fekete felirat" },
        { "value": "red", "label": "Piros csillag, fehér felirat" }
      ],
      "default": "white"
    },
    {
      "type": "range",
      "id": "burst_size",
      "min": 90,
      "max": 220,
      "step": 10,
      "unit": "px",
      "label": "Méret",
      "default": 150
    }
  ],
  "presets": [
    {
      "name": "Hero (piros fejléc)"
    }
  ]
}
{% endschema %}
