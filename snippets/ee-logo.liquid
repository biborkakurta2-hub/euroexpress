{%- comment -%}
  EuroExpress beépített SVG logó (wordmark).
  Akkor jelenik meg, ha a téma beállításokban nincs saját logókép feltöltve.
  Paraméter: height (px, alap 48)
{%- endcomment -%}
{%- assign ee_logo_h = height | default: 48 -%}
<svg class="ee-logo" role="img" aria-label="EuroExpress Áruház"
  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 360 96" height="{{ ee_logo_h }}"
  style="height:{{ ee_logo_h }}px;width:auto;display:block">
  <style>
    .ee-l-word { font-family: 'Montserrat', 'Arial Black', system-ui, sans-serif; font-weight: 800; letter-spacing:-1px; }
  </style>
  <rect x="0" y="0" width="360" height="66" rx="8" fill="#FFFFFF" stroke="#111111" stroke-width="4"/>
  <text x="18" y="48" class="ee-l-word" font-size="42" fill="#E30613">EURO</text>
  <text x="150" y="48" class="ee-l-word" font-size="42" fill="#111111">EXPRESS</text>
  <rect x="0" y="70" width="360" height="26" rx="6" fill="#E30613"/>
  <text x="180" y="89" class="ee-l-word" font-size="18" fill="#FFFFFF" text-anchor="middle" letter-spacing="6">Á R U H Á Z</text>
</svg>
